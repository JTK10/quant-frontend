[Unit]
Description=Viper Signal Phoenix bull and bear cash-confirmed scanner
After=network-online.target ocelot.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/viper-signal
ExecStart=/usr/bin/python3 -u /home/ubuntu/viper-signal/signal_live.py
Environment=TZ=Asia/Kolkata
Restart=on-failure
RestartSec=45
MemoryHigh=80M
MemoryMax=112M
CPUQuota=15%
Nice=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/viper-signal
PrivateTmp=true

[Install]
WantedBy=multi-user.target
