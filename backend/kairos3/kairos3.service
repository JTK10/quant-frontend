[Unit]
Description=Kairos 3.0 paper trades with Queue Selection & 3 Robustness Guards
After=network-online.target pallas.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kairos3
ExecStart=/home/ubuntu/ocelot/venv/bin/python -u /home/ubuntu/kairos3/kairos3_live.py
Restart=on-failure
RestartSec=15
MemoryHigh=64M
MemoryMax=96M
CPUQuota=15%
Nice=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/kairos3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
