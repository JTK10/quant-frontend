[Unit]
Description=Irbis morning scanner using existing cash and option captures
After=network-online.target ocelot.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/irbis
ExecStart=/usr/bin/python3 -u /home/ubuntu/irbis/irbis_live.py
Restart=on-failure
RestartSec=30
MemoryHigh=80M
MemoryMax=128M
CPUQuota=20%
Nice=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/irbis
PrivateTmp=true
Environment=TZ=Asia/Kolkata

[Install]
WantedBy=multi-user.target
